# Styfe HQ — copy to .env.local and fill in. .env.local is git-ignored.

# Public: safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Where magic links come back to. Leave blank locally (defaults to
# http://localhost:3000); set it to the live URL on Vercel.
NEXT_PUBLIC_SITE_URL=

# Server-only. Used by scripts/ (migrations, seeding, imports, sanity checks).
# NEVER import these from anything under app/ or components/.
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=
